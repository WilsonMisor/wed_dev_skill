{
  "router_id": "virtual-team-capability-router",
  "version": "1.0.0",
  "role_registry_version": "1.0.0",
  "authority_boundary": "Blueprint determines which capabilities apply. This router only maps approved capability IDs to canonical role IDs. It must not invent capabilities or roles.",
  "inputs_required": [
    "approved_capability_ids",
    "task_packet_id",
    "lifecycle_state",
    "active_profiles"
  ],
  "rules": [
    "Unknown capability => UNKNOWN_CAPABILITY and BLOCKED.",
    "Any unresolved specialist reference => ROLE_GAP.",
    "Duplicate roles are deduplicated by canonical role ID.",
    "/prod-full-review is an orchestration capability and receives the union of roles from the specific review capabilities selected by Blueprint; it must not automatically activate all forty roles."
  ],
  "routes": [
    {
      "capability": "/prod-intake",
      "required_role_ids": [
        "VT-R01-product-manager",
        "VT-R02-business-analyst",
        "VT-R03-domain-specialist"
      ],
      "routing_basis": "SOURCE_SPECIALISTS",
      "purpose": [
        "Understand what is being built before architecture begins"
      ],
      "outputs": [
        "Product context",
        "Actors",
        "Workflows",
        "Functional requirements",
        "Nonfunctional requirements",
        "Constraints",
        "Criticality classification",
        "Unknowns"
      ]
    },
    {
      "capability": "/prod-team",
      "required_role_ids": [
        "VT-R01-product-manager",
        "VT-R02-business-analyst"
      ],
      "routing_basis": "DERIVED_MINIMUM_ORCHESTRATION",
      "purpose": [
        "Determine which professional disciplines are required for this particular application",
        "It creates a responsibility matrix",
        "A simple brochure website might activate ten perspectives",
        "A payment marketplace might activate thirty or more",
        "The system must therefore avoid unnecessary complexity while preventing missing disciplines"
      ],
      "outputs": []
    },
    {
      "capability": "/prod-domain",
      "required_role_ids": [
        "VT-R03-domain-specialist"
      ],
      "routing_basis": "DERIVED_MINIMUM_ORCHESTRATION",
      "purpose": [
